# docker-compose.yml의 DB 비밀번호. DATABASE_URL의 비밀번호와 같아야 한다 (바꾸려면 'docker compose down -v'로 볼륨을 지우고 다시 만든다)
POSTGRES_PASSWORD=1234
DATABASE_URL=postgresql+psycopg://postgres:1234@127.0.0.1:5435/avengers_bank
JWT_SECRET_KEY=
# 액세스 토큰(JWT) 수명(분). 서버가 취소할 수 없는 토큰이라 짧게 둔다. 만료되면 갱신 토큰으로 다시 받는다
ACCESS_TOKEN_EXPIRE_MINUTES=5
# 갱신 토큰(세션) 수명(분). 갱신할 때마다 새로 연장된다 = 이 시간 동안 사용하지 않으면 다시 로그인
SESSION_EXPIRE_MINUTES=30
DB_ECHO=false
ENABLE_DEV_ENDPOINTS=true
# 프론트 주소 (쉼표로 구분). 생략하면 localhost:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 갱신 토큰·기기 토큰 쿠키(httpOnly, SameSite=Strict). 기본은 Secure(HTTPS 전용)·경로 /api/users(Next 프록시 /api 아래).
# 갱신·로그아웃·기기 해제는 Origin 헤더가 위 CORS_ORIGINS에 있어야 한다(CSRF 확인).
# http://로 여는 개발에서 쿠키가 안 실리면 아래를 false로 (운영은 반드시 true)
# COOKIE_SECURE=false
# REFRESH_COOKIE_PATH=/api/users
# DEVICE_COOKIE_DAYS=365
# AI 금융 비서 (docs/AGENT.md). 키가 없으면 /agent/chat만 503을 돌려준다. 키는 커밋하지 않는다
GEMINI_API_KEY=
AGENT_MODEL=gemini-2.5-flash
AGENT_TIMEOUT_SECONDS=30
# 약관 검색 (docs/TERMS_RAG.md). 모델·차원을 바꾸면 색인을 다시 만든다 (indexing --reindex)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
TERMS_MIN_SCORE=0.6
# ClearingHub 타행 이체 (docs/SPEC.md). 아래 값이 모두 있어야 타행 이체가 켜진다 (없으면 503 INTERBANK_DISABLED).
# 개인키·API 키·초대 코드는 .env에만 둔다(커밋 금지). 허브 주소·공개키는 공개 값이다
HUB_URL=https://clearing-hub.ai-agent-develop.cloud
HUB_PUBLIC_KEY=gMPteqXDjBBX0gsa9Mzp7siTFdx0bo0xB3Nyq5TKzZY=
# 아래는 셀프 등록(SPEC 3.5) 뒤 채운다
# BANK_NAME=SpiderBank
# BANK_CODE=
# BANK_API_KEY=
# BANK_PRIVATE_KEY=
# HUB_INVITE_CODE=  (등록 때만 쓰는 일회용 코드. 앱은 읽지 않는다)
