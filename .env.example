# docker-compose.yml의 DB 비밀번호. DATABASE_URL의 비밀번호와 같아야 한다 (바꾸려면 'docker compose down -v'로 볼륨을 지우고 다시 만든다)
POSTGRES_PASSWORD=1234
DATABASE_URL=postgresql+psycopg://postgres:1234@127.0.0.1:5435/avengers_bank
JWT_SECRET_KEY=
DB_ECHO=false
ENABLE_DEV_ENDPOINTS=true
# 프론트 주소 (쉼표로 구분). 생략하면 localhost:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# AI 금융 비서 (docs/AGENT.md). 키가 없으면 /agent/chat만 503을 돌려준다. 키는 커밋하지 않는다
GEMINI_API_KEY=
AGENT_MODEL=gemini-2.5-flash
AGENT_TIMEOUT_SECONDS=30
