# 운영 서버에서 .env.prod로 복사해서 채운다 (.env.prod는 저장소에 올리지 않는다).
# 도메인이 있으면 도메인(HTTPS 자동). 도메인 없이 HTTP로만 띄울 때는 :80 (C-053)
DOMAIN=api.example.com
# 비밀번호에 @ : / # 같은 특수문자가 있으면 URL 인코딩해야 한다 (예: @ → %40)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB_HOST:5432/avengers_bank
# 32자 이상의 새 값. 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ENABLE_DEV_ENDPOINTS=false
CORS_ORIGINS=https://app.example.com
