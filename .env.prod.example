# 운영 서버에서 .env.prod로 복사해서 채운다 (.env.prod는 저장소에 올리지 않는다).
# 도메인이 있으면 도메인(HTTPS 자동). 도메인 없이 HTTP로만 띄울 때는 :80 (C-053)
DOMAIN=api.example.com
# 비밀번호에 @ : / # 같은 특수문자가 있으면 URL 인코딩해야 한다 (예: @ → %40)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB_HOST:5432/avengers_bank
# 32자 이상의 새 값. 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ENABLE_DEV_ENDPOINTS=false
# 시연용 새 기기 인증을 쓸 때만 서버 .env.prod에 네 값을 모두 설정한다. 코드 원문은 저장소에 넣지 않는다.
# DEMO_DEVICE_LOGIN_ID=<시연 계정 아이디>
# DEMO_DEVICE_PHONE=<그 계정의 등록 휴대폰 번호>
# DEMO_DEVICE_CODE=<시연 담당자만 아는 숫자 6자리>
# DEMO_DEVICE_UNTIL=<시간대가 있는 ISO 8601 종료 시각, 예: 2026-11-12T00:00:00+09:00>
CORS_ORIGINS=https://app.example.com
# 쿠키 Secure(HTTPS 전용). 운영은 true(기본값)로 두고 끄지 않는다. 경로는 프론트 프록시의 /api/users
COOKIE_SECURE=true
